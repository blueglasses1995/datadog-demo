# Datadog API Key (Required)
# Get your API key from: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_datadog_api_key_here

# Datadog Site (Optional, default: datadoghq.com)
# For US1: datadoghq.com
# For US3: us3.datadoghq.com
# For US5: us5.datadoghq.com
# For EU: datadoghq.eu
# For AP1: ap1.datadoghq.com
DD_SITE=datadoghq.com

# Datadog Environment Tag
DD_ENV=dev

# Datadog Service Name
DD_SERVICE=datadog-demo

# Datadog Version Tag
DD_VERSION=1.0.0

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1

# Database Settings
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=demo_password
POSTGRES_DB=demo_db

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# RUM (Real User Monitoring) Settings
# Get your RUM Application ID and Client Token from Datadog RUM settings
REACT_APP_DD_RUM_APPLICATION_ID=your_rum_app_id
REACT_APP_DD_RUM_CLIENT_TOKEN=your_rum_client_token
REACT_APP_DD_RUM_SITE=datadoghq.com
REACT_APP_DD_RUM_SERVICE=frontend
REACT_APP_DD_RUM_ENV=dev
